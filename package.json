{
  "name": "gitlane",
  "version": "1.0.1",
  "license": "MIT",
  "description": "Local web UI for a git commit graph: colored lanes, inline details, and Monaco diffs.",
  "type": "module",
  "bin": {
    "gitlane": "src/cli.js"
  },
  "files": [
    "src",
    "web",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "git",
    "git-gui",
    "commit-graph",
    "diff",
    "monaco",
    "cli"
  ],
  "author": "eightHundreds",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eightHundreds/gitlane.git"
  },
  "homepage": "https://github.com/eightHundreds/gitlane",
  "bugs": {
    "url": "https://github.com/eightHundreds/gitlane/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
